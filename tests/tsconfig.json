{
	"compilerOptions": {
		"declaration": true,
		"lib": [
			"es6",
			"dom"
		],
		"module": "commonjs",
		"noFallthroughCasesInSwitch": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"removeComments": true,
		"sourceMap": true,
		"strict": true,
		"isolatedModules": true,
		"target": "es6",
		"types": [
			"jest",
			"node",
			"vscode"
		]
	}
}